<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.onfhir</groupId>
        <artifactId>onfhir-libs-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>onfhir-libs-bom</artifactId>
    <packaging>pom</packaging>
    <name>onFHIR Libraries BOM</name>
    <description>Dependency management for the onFHIR reusable library family.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-common_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-client_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-path_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-query_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-config_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-expression_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-validation_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-template-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-r4_2.13</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Resources-only artifacts: no Scala binary version suffix. -->
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-definitions-r4</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.onfhir</groupId>
                <artifactId>onfhir-definitions-r5</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
