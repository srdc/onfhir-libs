<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>onfhir-libs-parent</artifactId>
        <groupId>io.onfhir</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>onfhir-stu3_2.13</artifactId>
    <properties><library.gates.skip>false</library.gates.skip></properties>
    <name>FHIR STU3 implementation</name>
    <!-- Declared explicitly because Maven appends the artifactId to inherited
         URLs; published POMs must point at the repository root -->
    <url>https://github.com/srdc/onfhir-libs</url>
    <scm>
        <connection>scm:git:https://github.com/srdc/onfhir-libs.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/srdc/onfhir-libs.git</developerConnection>
        <url>https://github.com/srdc/onfhir-libs</url>
        <tag>HEAD</tag>
    </scm>
    <description>FHIR STU3 foundation-resource parsers, layered on the R4 parsers.</description>

    <packaging>jar</packaging>

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <testSourceDirectory>src/test/scala</testSourceDirectory>
        <plugins>
            <!-- Allows compiling/testing/running/documenting Scala code in Maven. -->
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- Scala Language -->
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
        </dependency>
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-common_${scala.binary.version}</artifactId>
            <version>${onfhir.libs.version}</version>
        </dependency>
        <!-- STU3Parser extends R4Parser and STU3StructureDefinitionParser extends
             the R4 StructureDefinitionParser, so this is a compile dependency. -->
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-r4_${scala.binary.version}</artifactId>
            <version>${onfhir.libs.version}</version>
        </dependency>
        <!-- Provider-neutral logging API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Integration tests only: the real FHIR STU3 standard definitions
             package and the release-neutral configuration pipeline that reads
             it. Neither is a compile dependency of this module. -->
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-definitions-stu3</artifactId>
            <version>${onfhir.libs.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.onfhir</groupId>
            <artifactId>onfhir-config_${scala.binary.version}</artifactId>
            <version>${onfhir.libs.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Unit Testing -->
        <dependency>
            <groupId>org.specs2</groupId>
            <artifactId>specs2-core_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.specs2</groupId>
            <artifactId>specs2-junit_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
